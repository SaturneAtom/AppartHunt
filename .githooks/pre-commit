#!/bin/sh
# Garde-fou : refuse tout commit qui contient des pièces du dossier locataire ou des données perso.
# core.quotePath=false : sinon un nom accentué (« Capture d’écran….png », « relevé.pdf ») arrive entre guillemets et passe.
bad=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep -i -E '^(ma-recherche/|dossier/pieces/|dossier/profil\.txt|data/|agent/data/|recherche\.md$|profil\.json$|zone\.json$|annonces\.md$|selection\.html$|choix\.json$|resumes\.json$|ecran\.json$|journal\.json$)|\.(pdf|jpe?g|png|heic|webp|gif|db|sqlite3?|jsonl)$' | grep -v -E '^(examples|app/icon|docs/images)/')
if [ -n "$bad" ]; then
  echo "Commit refusé : ces fichiers sont personnels et ne doivent pas partir sur GitHub :"
  echo "$bad"
  exit 1
fi
